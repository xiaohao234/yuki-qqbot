[Unit]
Description=Yuki (OneBot v11 WebSocket Server)
After=network.target

[Service]
Type=simple
# 如部署目录不是 /opt/yuki，请同步修改下面两行路径
WorkingDirectory=/opt/yuki
ExecStart=/opt/yuki/.venv/bin/python /opt/yuki/main.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# 管理员 QQ（#yukireboot / #log / /统计发言 等指令需设置；支持多个，逗号分隔，如 123,456；0=禁用）
Environment=BOT_ADMIN_QQ=0
# 如 NapCat 在另一台机器，取消下行注释并在宝塔放行 8082：
# Environment=BOT_HOST=0.0.0.0
# Environment=BOT_PORT=8082

[Install]
WantedBy=multi-user.target
