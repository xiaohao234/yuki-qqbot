# Python 运行产物
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 运行时数据（含真实 QQ 号/昵称，禁止上传）
data/
*.json.tmp

# 本机功能开关配置（模板见 config.example.json）
config.json

# 本地备份与临时文件
backup/
_dirlist.txt
_test*
*.log

# IDE
.idea/
.vscode/

# 安装脚本生成的本机环境记录
.install.env

# 渲染样例产物（可用 ptest/render_samples.py 重新生成）
ptest/*.png
